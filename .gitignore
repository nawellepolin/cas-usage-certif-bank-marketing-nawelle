# Python
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
*.egg-info/

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp

# Jupyter
.ipynb_checkpoints/

# Données : le CSV source est versionné explicitement (livré par la formation,
# nécessaire à la reproductibilité du repo) ; tout le reste sous data/ ne l'est pas.
data/*
!data/.gitkeep
!data/bank-additional-full.csv

# Modèles entraînés : gitignorés par défaut (trop lourds en général),
# sauf le modèle retenu servi par l'API (petit, nécessaire à un clone propre
# pour que les tests et la CI fonctionnent sans étape d'entraînement préalable).
models/*.joblib
models/*.pkl
!models/.gitkeep
!models/bank_marketing_scenario3.joblib

# MLflow (Phase 6bis+)
mlruns/
mlartifacts/

# Env
.env
.env.local

# Logs : seul le dossier (via .gitkeep) est versionné, pas les fichiers de logs générés
logs/*
!logs/.gitkeep

# Documents d'examen originaux (sujet/mail/dataset brut fournis par la formation)
consigne/

# Notes personnelles (préparation PPT) — jamais poussées
NOTES-PERSO.md
PPT-EBAUCHE.md

# Notebook fusionné (notebook + journal de bord) pour le rendu certif — artefact
# de soumission généré à partir des sources versionnées, pas du code à garder.
notebooks/*certif*.ipynb
